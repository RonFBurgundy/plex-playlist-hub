# ==============================================================================
# Plex Playlist Sync Configuration
# ==============================================================================

# -----------------
# Plex Settings (Required)
# -----------------
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here
PLEX_VERIFY_SSL=1                # Set to 0 to ignore SSL certificate validation (self-signed certs)

# -----------------
# General Sync Options
# -----------------
SECONDS_TO_WAIT=86400            # Seconds between sync loops (default: 86400 = 24 hours)
RUN_ONCE=0                       # Set to 1 to run a single sync and exit (for cron/scheduled tasks)
APPEND_INSTEAD_OF_SYNC=0         # 1 = Append tracks only; 0 = Sync/replace tracks in Plex playlist
APPEND_SERVICE_SUFFIX=1          # 1 = Append ' - Spotify' or ' - Deezer' to playlist title; 0 = exact title
ADD_PLAYLIST_POSTER=1            # 1 = Upload service playlist cover poster to Plex; 0 = skip
ADD_PLAYLIST_DESCRIPTION=1       # 1 = Set Plex playlist description/summary; 0 = skip
WRITE_MISSING_AS_CSV=0           # 1 = Write missing track lists to CSV in /data directory; 0 = skip
SEARCH_SIMILARITY_THRESHOLD=0.9  # Fuzzy title/artist similarity threshold (0.0 to 1.0)
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR

# -----------------
# Spotify Settings (Optional - requires Spotify Developer App)
# -----------------
SPOTIFY_CLIENT_ID=               # Spotify API client ID
SPOTIFY_CLIENT_SECRET=           # Spotify API client secret
SPOTIFY_USER_ID=                 # Spotify account username/ID (syncs all owned/created playlists)
SPOTIFY_PLAYLIST_ID=             # Space- or comma-separated list of Spotify playlist IDs or URIs

# -----------------
# Deezer Settings (Optional - no API credentials required)
# -----------------
DEEZER_USER_ID=                  # Deezer numerical profile ID
DEEZER_PLAYLIST_ID=              # Space- or comma-separated list of Deezer playlist IDs
